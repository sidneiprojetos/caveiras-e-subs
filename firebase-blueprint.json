{
  "entities": [
    {
      "name": "Member",
      "description": "Quadro de integrantes do sistema Gestão Operacional Sidnei",
      "collection": "members",
      "fields": [
        { "name": "id", "type": "string", "description": "Identificador único do integrante" },
        { "name": "name", "type": "string", "description": "Nome civil completo" },
        { "name": "vulgo", "type": "string", "description": "Nome de colete / apelido operacional" },
        { "name": "grupamento", "type": "string", "description": "Grupamento ou patente operacional" },
