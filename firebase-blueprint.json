        { "name": "divisaoName", "type": "string", "description": "Nome da divisão vinculada" },
        { "name": "status", "type": "string", "description": "Status operacional: Ativo, Afastado, etc." },
        { "name": "phone", "type": "string", "description": "Telefone / WhatsApp para contato" },
        { "name": "email", "type": "string", "description": "E-mail do integrante" },
        { "name": "entryDate", "type": "string", "description": "Data de entrada no sistema" },
        { "name": "grupamentoGraduationDate", "type": "string", "description": "Data de graduação no grupamento" },
        { "name": "observations", "type": "string", "description": "Observações operacionais e histórico" },
        { "name": "photoUrl", "type": "string", "description": "URL da foto do integrante" },
